{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hangline",
  "version": "1.4.0",
  "identifier": "app.hangline.Hangline",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/Hangline/**",
          "$PICTURE/Screenshots/**",
          "$VIDEO/Captures/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/devin2255/hangline/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQjYwNzNEQTAxMUZDMDYKUldRRy9CR2dQUWUycm1aRk1ieWlXTW5VdDY1Lzg2Qlo4UXRGREZPdmx6MlJ3RWJqb3MxVXJXa1MK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
